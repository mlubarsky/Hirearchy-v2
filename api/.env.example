# MongoDB Atlas connection string — REQUIRED. The API refuses to start without it.
# Get it from Atlas: Cluster → Connect → Drivers → copy the connection string,
# then replace <password> with your DB user's password.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=hirearchydb

# JWT signing — REQUIRED. Must be a strong random string of 32+ chars or the API
# refuses to start. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALG=HS256
JWT_EXPIRES_HOURS=168

# CORS — comma-separated list of allowed origins for the SPA
CORS_ORIGINS=http://localhost:5173
